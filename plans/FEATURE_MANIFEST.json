{
  "_about": "Point-in-time feature registry. Step 1 of plans/QUANT_SYSTEM_BUILD_PLAN.md. A feature not listed here cannot be loaded (js/harness/features.mjs throws). Data files live in features/<id>.parquet on the laptop (git-ignored); this manifest is the contract and is committed. The builder (analysis/features/build_features.py) fills status/rows/firstAsof/lastAsof/builtAt and never edits the rest.",
  "_asofRules": {
    "close+1h": "daily market data; asof = that trading day 22:00 UTC (OANDA daily close 21:00 UTC + 1h). Assumes the close is read directly, not from a next-day mirror.",
    "vintage": "ALFRED realtime_start; asof = that date 23:59:59 UTC. Conservative by up to one trading day; a study that needs intraday precision joins the calendar's release_ts instead.",
    "release_ts": "the calendar's release instant (epoch ms from the surprise store).",
    "report+3d": "CFTC: report date is Tuesday, published Friday 15:30 ET; asof = report date + 3 days 20:30 UTC.",
    "schedule-7d": "a scheduled event; asof = the event instant minus 7 days (known at least a week ahead).",
    "cache-day-end+1h": "London calendar-day aggregate built from the local M1 cache; asof = the last M1 bar of that London day + 1h.",
    "measured": "a profile measured live; asof = the measurement's own timestamp.",
    "fixed_lag:N": "date + N days 00:00 UTC; for an incomplete current period the builder uses the last observation + N days instead, so no asof is ever in the future."
  },
  "_kinds": {
    "series": "date, asof, value, vintage, source",
    "events": "date, asof, value, ccy, series, actual, estimate, source",
    "profile": "pair, hour, mean, sd, max, n, asof"
  },
