#!/bin/sh
# Guard tests before a push to main (2026-11-22).
#
# Why: from 2026-11-15 every CI "Tests" run on main failed, always on the same kind of test: a hand-kept list that a
# new page, route or mirror was not added to (js/infoMap.js EXCLUDED_PAGES, js/deskSnapshot.js FULL_EXCLUDED, the
# SCORE-DISPLAY mirror in desk-terminal.html, js/commandHub.js shortcuts, the service registry). These are fast,
# data-free checks, so they run here, before main is red, instead of 10 minutes later in CI.
#
# Runs only for pushes to refs/heads/main, against the working tree (normally the commit being pushed).
# Skip once with:  git push --no-verify   (or SKIP_GUARD=1 git push)
# Enable in a clone: git config core.hooksPath .githooks   (shared by every worktree of that clone)

[ -n "$SKIP_GUARD" ] && exit 0

to_main=0
while read -r _lref _lsha rref _rsha; do
  [ "$rref" = "refs/heads/main" ] && to_main=1
done
[ "$to_main" = 1 ] || exit 0

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
command -v node >/dev/null 2>&1 || { echo "[pre-push] node not found; guard tests skipped"; exit 0; }

TESTS="js/scoreDisplay.test.mjs js/infoMap.test.mjs js/deskSnapshot.test.mjs js/serviceFlags.test.mjs js/commandHub.test.mjs js/terminal/tabRegistry.test.mjs js/feedCoverage.test.mjs js/dataFeeds.test.mjs js/deskEvidence.test.mjs"

tmp=$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}/prepush.$$")
mkdir -p "$tmp"
echo "[pre-push] guard tests before pushing to main ..."
for t in $TESTS; do
  [ -f "$t" ] || continue
  ( node "$t" > "$tmp/$(echo "$t" | tr '/\\' '__').log" 2>&1; echo $? > "$tmp/$(echo "$t" | tr '/\\' '__').rc" ) &
done
wait

fail=0
for t in $TESTS; do
  [ -f "$t" ] || continue
  k=$(echo "$t" | tr '/\\' '__')
  if [ "$(cat "$tmp/$k.rc" 2>/dev/null)" != "0" ]; then
    fail=1
    echo ""
    echo "[pre-push] FAILED: $t"
    grep -E 'FAIL|✖|not ok|AssertionError|problems|  - ' "$tmp/$k.log" | head -15
  fi
done
rm -rf "$tmp"

if [ "$fail" = 1 ]; then
  echo ""
  echo "[pre-push] main would go red in CI. Fix the list the test names (usually one line), or push with --no-verify to override."
  exit 1
fi
echo "[pre-push] guard tests passed"
exit 0
