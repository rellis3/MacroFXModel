//@version=5
indicator("C.OG Line - pasted data", shorttitle="COG line", overlay=false)

// =====================================================================
// WHAT THIS IS
// C.OG's SOFR vs Euribor line, drawn from DATA YOU PASTE IN, so it needs no
// intraday SOFR / Euribor feed on your TradingView plan.
//   line (bp)  = SOFR rate - Euribor rate  (CME SOFR Sep26 minus ICE Euribor I2!)
//   line units = bp * 0.1 + 1.445          (his scale and default offset)
// Identified and checked against his video in
// analysis/output/cog_video_0918/RECONSTRUCTION.md.
//
// HOW TO USE
// 1. Open the Rates page (rates.html), card "C.OG line".
// 2. Pick the number of days and press "Copy for TradingView".
// 3. On a 15-minute chart, add this indicator, open its settings and paste the
//    copied text into "Pasted data", then press OK.
// 4. A grey status box (top right) always shows what was parsed. If it says
//    "No data", the paste did not arrive; if it shows a data range, the line is
//    drawn wherever your chart's bars fall inside that range.
// 5. "Offset the line" moves it right (+) or left (-) in chart bars (96 = one
//    day on a 15-minute chart). C.OG's script defaults to +1 day; his video used 0.
// Use a 15-minute chart: the data is one value per 15-minute bar.
// =====================================================================

data    = input.text_area("", "Pasted data (Rates page > C.OG line > Copy for TradingView)", group="Data")
showAs  = input.string("C.OG units (bp x scale + offset)", "Show", options=["C.OG units (bp x scale + offset)", "Spread (bp)"], group="Display")
scale   = input.float(0.1, "Scale", step=0.01, group="Mapping")
offs    = input.float(1.445, "Offset", step=0.001, group="Mapping")
smooth  = input.int(2, "Smoothing (EMA, bars; 1 = off)", minval=1, group="Mapping")
shift   = input.int(0, "Offset the line (chart bars, + right / - left)", minval=-500, maxval=500, group="Offset")
onPrice = input.bool(false, "Also draw on the price pane (rescaled to the visible range)", group="Overlay")
fitLen  = input.int(250, "Rescale look-back (bars)", minval=10, group="Overlay")
lineCol = input.color(color.blue, "Line colour", group="Style")
lineW   = input.int(2, "Line width", minval=1, maxval=4, group="Style")

// ---- read one "key=value" token from the pasted text -------------------------
// The text is flattened first (new lines and carriage returns become spaces), so it
// parses the same whether or not the text box kept the line breaks.
f_field(s, key) =>
    p = str.pos(s, key)
    string r = ""
    if not na(p)
        rest = str.substring(s, p + str.length(key))
        parts = str.split(rest, " ")
        r := array.get(parts, 0)
    r

// ---- parse once ----------------------------------------------------------------
var float[] vals = array.new_float()
var float t0 = na
var float stepS = 900.0
var string asofS = "-"
var int rawLen = 0
if barstate.isfirst
    clean = " " + str.replace_all(str.replace_all(data, "\r", " "), "\n", " ")
    rawLen := str.length(data)
    t0s = f_field(clean, " t0=")
    sts = f_field(clean, " step=")
    asofS := f_field(clean, " asof=")
    ds = f_field(clean, " d=")
    if str.length(t0s) > 0
        t0 := str.tonumber(t0s)
    if str.length(sts) > 0
        stepS := str.tonumber(sts)
    if str.length(ds) > 0
        parts = str.split(ds, ",")
        for j = 0 to array.size(parts) - 1
            p = array.get(parts, j)
            array.push(vals, str.length(p) == 0 ? na : str.tonumber(p) / 10.0)

nVals = array.size(vals)

// ---- value for this bar (data is stored at each 15-minute bar's OPEN time) ----
barSec = time / 1000.0
idx = na(t0) ? -1 : int(math.floor((barSec - t0) / stepS + 0.0001))
inRange = idx >= 0 and idx < nVals
raw = inRange ? array.get(vals, idx) : na
v = showAs == "Spread (bp)" ? raw : raw * scale + offs
lv = ta.ema(v, smooth)

plot(lv, "C.OG line", color=lineCol, linewidth=lineW, offset=shift)

// ---- optional: the same line rescaled onto the price pane ----------------------
sHi = ta.highest(lv, fitLen)
sLo = ta.lowest(lv, fitLen)
pHi = ta.highest(high, fitLen)
pLo = ta.lowest(low, fitLen)
fitted = (na(sHi) or sHi == sLo) ? na : pLo + (lv - sLo) / (sHi - sLo) * (pHi - pLo)
plot(onPrice ? fitted : na, "C.OG line on price (rescaled)", color=color.new(lineCol, 20), linewidth=lineW, offset=shift, force_overlay=true)

// ---- status box: always shown, so a failure is visible ----------------------------
dataEnd = na(t0) ? na : t0 + (nVals - 1) * stepS
var table info = table.new(position.top_right, 1, 3, bgcolor=color.new(color.gray, 80))
if barstate.islast
    msg = na(t0) ? "No data parsed (pasted " + str.tostring(rawLen) + " characters). Paste the whole block from the Rates page." : "Data " + str.format_time(int(t0 * 1000), "yyyy-MM-dd HH:mm", "UTC") + " to " + str.format_time(int(dataEnd * 1000), "yyyy-MM-dd HH:mm", "UTC") + " UTC, " + str.tostring(nVals) + " bars"
    table.cell(info, 0, 0, msg, text_color=color.gray, text_size=size.small)
    chartOk = timeframe.in_seconds() == 900
    table.cell(info, 0, 1, chartOk ? "" : "Chart is not 15 minutes: use a 15-minute chart", text_color=color.orange, text_size=size.small)
    stale = not na(dataEnd) and time / 1000.0 > dataEnd + 7200
    table.cell(info, 0, 2, stale ? "Chart is newer than the pasted data: refresh and copy again" : "", text_color=color.red, text_size=size.small)
