//@version=6
indicator("C.og - OI Walls & Max Pain v1", overlay=true, max_lines_count=500, max_labels_count=500)

// =====================================================
// HOW TO USE
// =====================================================
// 1. On the dashboard (index.html toolbar → "⬇ OI Walls",
//    or vol-forecast-v2 → Export ▾ → "⬇ OI Walls"), click
//    the button to copy the OI block.
// 2. Paste it into the input below.
// 3. This indicator draws horizontal lines for the CURRENT
//    chart symbol only, coloured by type:
//      • call_wall  → RED    (resistance ceiling — heavy call OI above)
//      • put_wall   → GREEN  (support floor — heavy put OI below)
//      • max_pain   → YELLOW (pin / magnet strike, dashed)
//      • gamma_flip → PURPLE (long↔short-gamma regime boundary)
//    Line thickness scales with wall strength (tier t1..t3).
// 4. Set Alert Proximity and enable via TradingView's alert
//    panel (any condition → this indicator → "OI Proximity Alert").
//
// STALENESS: the levels are only as fresh as your last option-
// chain paste on the dashboard. Each pair block in the paste
// carries a "· saved …" line so you can see how old it is.
// Refresh the paste each day (or after a big move / new expiry).
//
// LEVEL TYPES IN EXPORT:
//   call_wall  — strongest call-OI strikes above (resistance). t3 = strongest.
//   put_wall   — strongest put-OI strikes below (support).     t3 = strongest.
//   max_pain   — option max-pain strike (price-pinning magnet).
//   gamma_flip — dealer gamma sign change (regime boundary).

// =====================================================
// INPUTS — TICKER MAPPING (match your chart symbols)
// =====================================================

goldChart  = input.string("XAUUSD",    "Gold chart ticker",   group="Symbol Mapping")
nqChart    = input.string("NQ1!",      "NQ chart ticker",     group="Symbol Mapping")
spxChart   = input.string("SPX500USD", "SPX500 chart ticker", group="Symbol Mapping")
de30Chart  = input.string("GER40",     "DE30 chart ticker",   group="Symbol Mapping")
uk100Chart = input.string("UK100GBP",  "UK100 chart ticker",  group="Symbol Mapping")
us30Chart  = input.string("US30USD",   "US30 chart ticker",   group="Symbol Mapping")
us2kChart  = input.string("US2000USD", "US2000 chart ticker", group="Symbol Mapping")

// =====================================================
// INPUT — PASTE OI BLOCK FROM DASHBOARD
// =====================================================

oiText = input.text_area(
     title  = "Paste OI Block (from ⬇ OI Walls button)",
     defval =
"──── OI WALLS & MAX PAIN ───────────────────\n" +
"Generated: latest\n" +
"\n" +
"EURUSD\n" +
"· saved 7/21/2026, 08:15:00 · spot 1.0955 · DTE 4\n" +
"OI 1.10500 : call_wall t2\n" +
"OI 1.10000 : call_wall t3\n" +
"OI 1.09600 : gamma_flip\n" +
"OI 1.09480 : max_pain\n" +
"OI 1.09000 : put_wall t3\n" +
"\n" +
"GOLD\n" +
"OI 2400.00 : call_wall t3\n" +
"OI 2350.00 : max_pain\n" +
"OI 2300.00 : put_wall t2"
)

// =====================================================
// STYLE INPUTS
// =====================================================

col_call  = input.color(color.new(color.red,     0), "Call Wall Colour (resistance)", group="Colours")
col_put   = input.color(color.new(color.green,   0), "Put Wall Colour (support)",     group="Colours")
col_pain  = input.color(color.new(color.yellow,  0), "Max Pain Colour (magnet)",      group="Colours")
col_gamma = input.color(color.new(color.purple,  0), "Gamma Flip Colour (regime)",    group="Colours")

base_width  = input.int(2, "Base Line Width", minval=1, maxval=4, group="Colours",
     tooltip="Walls with a higher strength tier (t2, t3) draw thicker than this base.")
show_label  = input.bool(true, "Show Labels",                    group="Colours")
show_tier   = input.bool(true, "Show Strength Tier in Label",    group="Colours")
show_table  = input.bool(true, "Show Summary Table",             group="Colours")
extend_right = input.bool(true, "Extend Lines Right",            group="Colours")

alert_pips      = input.float(5.0, "Alert Proximity (pips)", minval=0.1, step=0.5, group="Alerts",
     tooltip="Fire alert when close comes within this many pips of any OI level.")
alert_min_tier  = input.int(1, "Min Wall Tier for Alert", minval=1, maxval=3, group="Alerts",
     tooltip="Only alert on walls at/above this strength tier. Max pain & gamma flip always alert.")

// =====================================================
// SYMBOL NORMALISATION (matches the dashboard export headers)
// =====================================================

f_normaliseTicker(t, goldT, nqT, spxT, de30T, uk100T, us30T, us2kT) =>
    r = t
    tU = str.upper(t)
    if tU == str.upper(goldT) or tU == "XAUUSD" or tU == "GOLD"
        r := "GOLD"
    else if tU == str.upper(nqT) or tU == "NQ1!" or tU == "NQ" or tU == "NASDAQ100" or tU == "NAS100USD"
        r := "NQ"
    else if tU == str.upper(spxT) or tU == "SPX500USD" or tU == "US500" or tU == "SP1!"
        r := "SPX500"
    else if tU == str.upper(de30T) or tU == "GER40" or tU == "GER30" or tU == "DE30EUR" or tU == "DE30USD" or tU == "FDAX1!"
        r := "DE30"
    else if tU == str.upper(uk100T) or tU == "UK100GBP" or tU == "Z1!" or tU == "FTSE100"
        r := "UK100"
    else if tU == str.upper(us30T) or tU == "US30USD" or tU == "DJIA" or tU == "YM1!"
        r := "US30"
    else if tU == str.upper(us2kT) or tU == "US2000USD" or tU == "RTY1!" or tU == "RUT"
        r := "US2000"
    r

// =====================================================
// PIP SIZE (for alert proximity + label distance)
// =====================================================

f_pipSize(sym) =>
    symU = str.upper(sym)
    symU == "GOLD"                                   ? 0.1    :
     symU == "NQ" or symU == "US30"                 ? 1.0    :
     symU == "SPX500" or symU == "DE30" or
      symU == "UK100" or symU == "US2000"            ? 1.0    :
     str.contains(symU, "JPY")                       ? 0.01   : 0.0001

// Known ticker names to detect symbol-header lines
f_isKnownTicker(rowUp) =>
    (str.contains(rowUp, "GOLD")   or str.contains(rowUp, "NQ")     or
     str.contains(rowUp, "EURUSD") or str.contains(rowUp, "GBPUSD") or
     str.contains(rowUp, "USDJPY") or str.contains(rowUp, "AUDUSD") or
     str.contains(rowUp, "NZDUSD") or str.contains(rowUp, "USDCAD") or
     str.contains(rowUp, "USDCHF") or str.contains(rowUp, "GBPJPY") or
     str.contains(rowUp, "EURGBP") or str.contains(rowUp, "EURJPY") or
     str.contains(rowUp, "EURCHF") or str.contains(rowUp, "GBPCHF") or
     str.contains(rowUp, "AUDJPY") or str.contains(rowUp, "CADJPY") or
     str.contains(rowUp, "SPX500") or str.contains(rowUp, "DE30")   or
     str.contains(rowUp, "UK100")  or str.contains(rowUp, "US2000") or
     str.contains(rowUp, "US30"))

// =====================================================
// PARSE OI BLOCK
// =====================================================

var float[]  oiPrices = array.new_float()
var string[] oiTypes  = array.new_string()
var int[]    oiTiers  = array.new_int()

if barstate.isfirst
    sym   = f_normaliseTicker(syminfo.ticker, goldChart, nqChart, spxChart, de30Chart, uk100Chart, us30Chart, us2kChart)
    symUp = str.upper(sym)
    rows  = str.split(oiText, "\n")
    n     = array.size(rows)

    bool inSymBlock = false

    if n > 0
        for i = 0 to n - 1
            rawRow = str.trim(array.get(rows, i))
            if str.length(rawRow) < 2
                inSymBlock := false
                continue
            rowUp = str.upper(rawRow)

            // Header / meta lines we ignore
            if str.contains(rowUp, "OI WALLS") or str.contains(rowUp, "GENERATED:") or str.contains(rowUp, "TYPES:")
                continue

            // Symbol-header line → is this our chart's symbol block?
            if not str.startswith(rawRow, "OI ") and not str.startswith(rawRow, "·") and f_isKnownTicker(rowUp) and str.length(rawRow) <= 12
                inSymBlock := str.contains(rowUp, symUp)
                continue

            // Level line: "OI {price} : {type} [t{n}]"
            if inSymBlock and str.startswith(rawRow, "OI ")
                parts = str.split(rawRow, " : ")
                if array.size(parts) == 2
                    priceStr = str.trim(str.replace_all(array.get(parts, 0), "OI ", ""))
                    rhs      = str.trim(array.get(parts, 1))
                    price    = str.tonumber(priceStr)
                    // type = first token; tier = trailing t{n} if present
                    rhsParts = str.split(rhs, " ")
                    typ      = array.size(rhsParts) >= 1 ? str.trim(array.get(rhsParts, 0)) : rhs
                    int tier = 0
                    if array.size(rhsParts) >= 2
                        tstr = str.trim(array.get(rhsParts, 1))
                        if str.startswith(tstr, "t")
                            tier := int(str.tonumber(str.replace_all(tstr, "t", "")))
                    if not na(price) and price > 0
                        array.push(oiPrices, price)
                        array.push(oiTypes,  typ)
                        array.push(oiTiers,  na(tier) ? 0 : tier)

// =====================================================
// DRAW LEVELS
// =====================================================

var line[]  oiLines  = array.new_line()
var label[] oiLabels = array.new_label()

f_typeColour(typ) =>
    typ == "call_wall"  ? col_call :
     typ == "put_wall"  ? col_put  :
     typ == "max_pain"  ? col_pain :
     typ == "gamma_flip" ? col_gamma : color.gray

f_typeStyle(typ) =>
    typ == "max_pain"   ? line.style_dashed :
     typ == "gamma_flip" ? line.style_dotted : line.style_solid

if barstate.islast
    // Cleanup
    int _nl = array.size(oiLines)
    if _nl > 0
        for i = 0 to _nl - 1
            line.delete(array.get(oiLines, i))
    array.clear(oiLines)
    int _nlab = array.size(oiLabels)
    if _nlab > 0
        for i = 0 to _nlab - 1
            label.delete(array.get(oiLabels, i))
    array.clear(oiLabels)

    nLev = array.size(oiPrices)
    if nLev > 0
        for i = 0 to nLev - 1
            zPrice = array.get(oiPrices, i)
            zType  = array.get(oiTypes,  i)
            zTier  = array.get(oiTiers,  i)
            zCol   = f_typeColour(zType)
            zStyle = f_typeStyle(zType)
            // Strength: t2 = +1, t3 = +2 to the base width (walls only)
            zW     = base_width + (zTier >= 3 ? 2 : zTier == 2 ? 1 : 0)
            zExt   = extend_right ? extend.right : extend.none

            ln = line.new(bar_index - 1, zPrice, bar_index + 3, zPrice,
                 color=zCol, width=zW, style=zStyle, extend=zExt)
            array.push(oiLines, ln)

            if show_label
                string lText = zType
                if show_tier and zTier > 0
                    lText := lText + " t" + str.tostring(zTier)
                lb = label.new(bar_index + 4, zPrice, lText,
                     style=label.style_label_left,
                     color=color.new(zCol, 75), textcolor=zCol,
                     size=size.small)
                array.push(oiLabels, lb)

// =====================================================
// SUMMARY TABLE
// =====================================================

var table oiTable = na

if show_table and barstate.islast
    table.delete(oiTable)
    nLev = array.size(oiPrices)
    if nLev > 0
        oiTable := table.new(position.top_right, 3, nLev + 1,
             bgcolor=color.new(color.black, 60),
             border_width=1, border_color=color.new(color.gray, 60),
             frame_width=1,  frame_color=color.new(color.gray, 50))

        table.cell(oiTable, 0, 0, "Level",  text_color=color.new(color.white, 40), text_size=size.tiny, bgcolor=color.new(color.gray, 80))
        table.cell(oiTable, 1, 0, "Type",   text_color=color.new(color.white, 40), text_size=size.tiny, bgcolor=color.new(color.gray, 80))
        table.cell(oiTable, 2, 0, "Dist",   text_color=color.new(color.white, 40), text_size=size.tiny, bgcolor=color.new(color.gray, 80))

        sym = f_normaliseTicker(syminfo.ticker, goldChart, nqChart, spxChart, de30Chart, uk100Chart, us30Chart, us2kChart)
        pip = f_pipSize(sym)

        for i = 0 to nLev - 1
            zPrice = array.get(oiPrices, i)
            zType  = array.get(oiTypes,  i)
            zTier  = array.get(oiTiers,  i)
            zCol   = f_typeColour(zType)
            pipDist = math.round(math.abs(close - zPrice) / pip, 1)
            tierStr = zTier > 0 ? " t" + str.tostring(zTier) : ""
            bg     = color.new(zCol, 80)
            table.cell(oiTable, 0, i + 1, str.tostring(zPrice), text_color=zCol, text_size=size.tiny, bgcolor=bg)
            table.cell(oiTable, 1, i + 1, zType + tierStr,      text_color=zCol, text_size=size.tiny, bgcolor=bg)
            table.cell(oiTable, 2, i + 1, str.tostring(pipDist) + "p", text_color=zCol, text_size=size.tiny, bgcolor=bg)

// =====================================================
// PROXIMITY ALERT
// =====================================================

f_anyLevelNear() =>
    sym  = f_normaliseTicker(syminfo.ticker, goldChart, nqChart, spxChart, de30Chart, uk100Chart, us30Chart, us2kChart)
    pip  = f_pipSize(sym)
    dist = alert_pips * pip
    near = false
    n    = array.size(oiPrices)
    if n > 0
        for i = 0 to n - 1
            zType = array.get(oiTypes, i)
            zTier = array.get(oiTiers, i)
            isWall = zType == "call_wall" or zType == "put_wall"
            // Walls gated by tier; max pain / gamma flip always eligible
            if (not isWall) or zTier >= alert_min_tier
                if math.abs(close - array.get(oiPrices, i)) <= dist
                    near := true
                    break
    near

bool nearLevel = f_anyLevelNear()

if nearLevel and not nearLevel[1]
    alert("OI: price approaching a wall / max-pain level on " + syminfo.ticker, alert.freq_once_per_bar_close)

alertcondition(nearLevel, title="OI Proximity Alert",
     message="Price near an OI wall / max-pain level on {{ticker}}")

// Hidden plot so alertcondition can reference the symbol context
plot(nearLevel ? close : na, display=display.none, title="_oi_alert_ref")
