//@version=6
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// OI PROFILE — the options book as a picture: reaction levels + zones on the chart, and a five-column profile in the empty space RIGHT of the last bar
//   GEX PROFILE  per-strike dealer gamma of the STRONGEST-DTE book (green = long gamma/pins, red = short gamma/amplifies)
//   VANNA        per-strike vanna (cyan +, magenta −)           VOLUME   today's traded options volume by strike
//   VEGA         gross vega by strike, whole book (purple): where the book is most sensitive to a vol move
//   OI CHG       the day's change in open interest by strike
//   TOUCH READ   (2026-11-26) every level replays today's bars: untouched / testing now / held ×N / broke ×N, and what the NEXT touch did in our
//                data (oi-profile-lines, 13k touches on these exact lines vs the same line moved 0.25-0.5σ). Almost every path is 50/50. Two
//                are not: ★ the gamma peak on a PIN day, first touch after this morning's capture (held 70%, a candidate scored forward), and a
//                third touch after held→broke (held 36% vs 47%, a hint, not significant). The IV smile and gamma helix columns were removed.
//
// DATA: paste the export from  <dashboard>/api/oi-profile/export?pair=nq   (or the "Profile export" button on the OI Lab page) into the box below. One paste per
// day is plenty — the levels are daily. Several instruments can be pasted together; the block matching the chart's symbol is used.
// TIP: drag the chart left (or scroll the time axis) so the empty space on the right is on screen — that is where the profile is drawn.
//
// STATUS: a picture of the book, NOT a signal. The gamma SIGN as a range read is real on NQ; walls/flips reacted like any neighbouring strike in our placebo tests.
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
indicator("OI Profile", shorttitle="OI Profile", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_polylines_count=100, max_bars_back=2000)

// ── Inputs ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────
G1 = "1 · Data"
pasteTxt = input.text_area("", "Paste the OI Profile export", group=G1, tooltip="Paste the whole export here: one instrument (~4,000 characters) or every instrument (~36,000). Pine v6 allows strings up to 40,960 characters.")
overrideKey = input.string("", "Force instrument (blank = auto)", group=G1, tooltip="Normally leave blank: the chart is matched with the Symbol Mapping boxes below (same as the Volatility Overlay and Confluence Zones indicators). Only to force a block name such as NQ or GOLD.")
GM = "1b · Symbol Mapping (match your chart symbols)"
goldChart  = input.string("XAUUSD",    "Gold chart ticker",   group=GM)
nqChart    = input.string("NAS100USD", "NQ chart ticker",     group=GM)
spxChart   = input.string("SPX500USD", "SPX500 chart ticker", group=GM)
de30Chart  = input.string("GER40",     "DE30 chart ticker",   group=GM)
uk100Chart = input.string("UK100GBP",  "UK100 chart ticker",  group=GM)
us30Chart  = input.string("US30USD",   "US30 chart ticker",   group=GM)
us2kChart  = input.string("US2000USD", "US2000 chart ticker", group=GM)
G2 = "2 · Show"
showLevels = input.bool(true, "Reaction levels", group=G2)
showZones  = input.bool(false, "Reaction zones (soft bands behind levels)", group=G2)
showMinor  = input.bool(false, "Minor levels (vanna, charm, volume, gamma peak)", group=G2)
showEM     = input.bool(false, "Expected move edges (options-implied range, not a level)", group=G2, tooltip="The ±1σ range implied by option prices. A ruler, not a reaction level, so it never takes one of the Max levels slots.")
maxLevels  = input.int(7, "Max levels shown", minval=1, maxval=50, group=G2, tooltip="Keeps the most important levels: walls, zero gamma, GEX flip, max pain, the day's expected-move edges. Raise it to see more (up to 50; the 'All lines' paste has 30-40 per market). Labels are spaced so they do not overlap, so with many levels some sit below their line.")
showEM     = input.bool(true, "Expected-move box", group=G2)
showTable  = input.bool(true, "Summary table", group=G2)
showGex    = input.bool(true, "GEX profile", group=G2)
showVanna  = input.bool(true, "Vanna", group=G2)
showVol    = input.bool(true, "Volume", group=G2)
showChg    = input.bool(true, "OI change", group=G2, tooltip="The day's net change in open interest by strike: green = contracts added (positioning building), red = contracts closed (unwinding). Updated once a day with the OI snapshot.")
showVega   = input.bool(true, "Vega", group=G2, tooltip="Gross vega by strike, the whole book (all expiries, calls plus puts): where the options book is most sensitive to a move in implied vol. A picture of the book, not a signal; dealers hedge vega with options, not the underlying.")
showRead   = input.bool(true, "Touch read (today's touches + what the next touch did in our data)", group=G2, tooltip="Each level replays today's bars from London midnight with the study's rules: a close 0.25σ away arms it, a trade at the level is a touch, then held = 0.25σ back before 0.25σ through. The label shows today's record and what the next touch did in 13k touches on these lines. Needs an export with sig (from 2026-11-26).")
G3 = "3 · Layout"
lineStart = input.string("London midnight", "Lines start at", options=["London midnight", "Fixed bars back"], group=G3, tooltip="London midnight: every line is anchored at 00:00 Europe/London, the start of the trading day, and runs to the profile (intraday charts only; on daily and above it falls back to a fixed length). Fixed bars back: the old 120-bar line.")
lineEnd   = input.string("Profile", "Lines end at", options=["Profile", "London midnight"], group=G3, tooltip="Profile: lines run to the profile panel just right of the last bar. London midnight: lines stop at the next 00:00 London and the panel moves out to just after it (scroll the chart right to see it).")
gapBars   = input.int(6, "Gap right of the last bar (bars)", minval=1, maxval=80, group=G3)
colW      = input.int(14, "Column width (bars)", minval=6, maxval=40, group=G3, tooltip="Wider = finer bars (bar lengths are whole bars).")
colGap    = input.int(5, "Gap between columns (bars)", minval=1, maxval=30, group=G3)
zoneFrac  = input.float(0.05, "Zone half-height (× expected-move scale)", minval=0.005, maxval=0.5, step=0.005, group=G3)
lblSizeIn = input.string("small", "Label size", options=["tiny", "small", "normal"], group=G3)
labelSide = input.string("right", "Level labels on the", options=["right", "left"], group=G3, tooltip="Right: next to the profile columns. Left: at the start of the lines.")
tblSize   = input.string("tiny", "Table text size", options=["tiny", "small"], group=G3)
tblPos    = input.string("bottom left", "Table position", options=["top left", "top right", "bottom left", "bottom right"], group=G3)
G4 = "4 · Colours"
cCall  = input.color(#ff5b6e, "Call wall / short gamma", group=G4)
cPut   = input.color(#2dd4a0, "Put wall / long gamma", group=G4)
cZero  = input.color(#a78bfa, "Zero gamma / GEX flip", group=G4)
cPain  = input.color(#e6c84a, "Max pain", group=G4)
cVanna = input.color(#ff7ad9, "Vanna flip", group=G4)
cCharm = input.color(#ff9f43, "Charm flip", group=G4)
cVol   = input.color(#4aa8ff, "Volume", group=G4)
cEM    = input.color(#f0b04a, "Expected move", group=G4)
cSmile = input.color(#ffd166, "ATM IV text", group=G4)
cVega  = input.color(#c084fc, "Vega", group=G4)
cPeak  = input.color(#e2e8f0, "Gamma peak", group=G4)

tblPosition = tblPos == "top right" ? position.top_right : tblPos == "bottom left" ? position.bottom_left : tblPos == "bottom right" ? position.bottom_right : position.top_left

// ── Parsed data (filled once, on the first bar) ───────────────────────────────────────────────────────────────────────────────
var string mName = ""
var string mGen = ""
var string mRegime = ""
var string mBook = ""
var string mTerms = "spot"
var string mSaved = ""
var float mSpot = na
var float mNet = na
var float mBookPct = na
var float mZg = na
var float mFlip = na
var float mEmHi = na
var float mEmLo = na
var float mEmPct = na
var float mIv = na
var float mRr = na
var float mVegaPk = na
var float mRef = na
var float mBinw = na
var float mUp1 = na
var float mDn1 = na
var array<string> lvType = array.new_string()
var array<string> lvLabel = array.new_string()
var array<string> lvExp = array.new_string()
var array<float> lvChg = array.new_float()
var array<float> lvPrice = array.new_float()
var array<float> lvStr = array.new_float()
var array<float> lvTouch = array.new_float()
var array<float> lvEta = array.new_float()
var array<float> gP = array.new_float()
var array<float> gN = array.new_float()
var array<float> vP = array.new_float()
var array<float> vV = array.new_float()
var array<float> oP = array.new_float()
var array<float> oV = array.new_float()
var array<float> cP = array.new_float()
var array<float> cV = array.new_float()
var array<float> wP = array.new_float()
var array<float> wV = array.new_float()
var float mSig = na
var float mGpSince = na
var bool parsed = false
var string parseNote = ""

f_num(a, i) =>
    i < array.size(a) ? str.tonumber(str.trim(array.get(a, i))) : na

f_str(a, i) =>
    i < array.size(a) ? str.trim(array.get(a, i)) : ""

// OI change chip for a level: "  ·  OI +12%" (building) or "  ·  OI -5%" (unwinding) when the day moved the OI at that strike by 3% or more of it
f_chgChip(i) =>
    float c = i < array.size(lvChg) ? array.get(lvChg, i) : na
    na(c) ? "" : math.abs(c) >= 3 ? "  ·  OI " + (c > 0 ? "+" : "") + str.tostring(c, "#") + "%" : ""

// Same chart-symbol normaliser as pine/Confluence Zones Indicator.pine and the Volatility Overlay (gold/index/commodity/futures aliases; FX pairs pass through)
f_normaliseTicker(t, goldT, nqT, spxT, de30T, uk100T, us30T, us2kT) =>
    r = t
    tU = str.upper(t)
    if tU == str.upper(goldT) or tU == "XAUUSD" or tU == "GOLD"
        r := "GOLD"
    // BARE, NO-CURRENCY-SUFFIX forms added below (NAS100/SPX500/DE30/UK100/US30/US2000,
    // plus NQ's US100). Gold and every FX pair never needed this: the pair name itself
    // already carries both currencies (EURUSD, XAUUSD), so nothing was missing there.
    // Indices are the one class where a lot of non-OANDA CFD feeds (ICMarkets,
    // Pepperstone, and others) list the ticker with NO trailing currency code at all —
    // every hardcoded fallback here previously required one (NAS100USD, SPX500USD,
    // GER40/GER30, UK100GBP, US30USD, US2000USD), so a chart on any of those bare
    // tickers fell through to the unmatched `r = t` passthrough at the end of this
    // function, never equalled any of "GOLD"/"NQ"/"SPX500"/etc., and every symbol-block
    // match against the pasted text (`inSymBlock := str.contains(rowUp, symUp)`) failed
    // silently for every single index while gold/FX kept working — exactly the reported
    // symptom (2026-09-18).
    else if tU == str.upper(nqT) or tU == "NQ1!" or tU == "NQ" or tU == "NASDAQ100" or tU == "NAS100USD" or tU == "NAS100" or tU == "US100"
        r := "NQ"
    else if tU == str.upper(spxT) or tU == "SPX500USD" or tU == "SPX500" or tU == "US500" or tU == "SP1!"
        r := "SPX500"
    else if tU == str.upper(de30T) or tU == "GER40" or tU == "GER30" or tU == "DE30EUR" or tU == "DE30USD" or tU == "DE30" or tU == "DE40" or tU == "FDAX1!"
        r := "DE30"
    else if tU == str.upper(uk100T) or tU == "UK100GBP" or tU == "UK100" or tU == "Z1!" or tU == "FTSE100" or tU == "FTSE"
        r := "UK100"
    else if tU == str.upper(us30T) or tU == "US30USD" or tU == "US30" or tU == "DJIA" or tU == "DJI30" or tU == "YM1!"
        r := "US30"
    else if tU == str.upper(us2kT) or tU == "US2000USD" or tU == "US2000" or tU == "RTY1!" or tU == "RUT"
        r := "US2000"
    // BTC feeds vary by exchange — normalise the common tickers to the export's BTCUSD
    else if tU == "BTCUSDT" or tU == "XBTUSD" or tU == "BTCUSD.P" or tU == "BTCUSDT.P" or tU == "BTC1!"
        r := "BTCUSD"
    // 2026-10-02 — commodities. The export names them the way it names gold (SILVER, WTI,
    // CORN …, matching cog_volatility_v3_sessions.pine). The OANDA CFD ticker and the
    // continuous CME future both map here. A CME chart (SI1!, ZC1!) needs the export's
    // ?terms=futures levels — the same rule as NQ1! — and grains then come in cents.
    else if tU == "XAGUSD" or tU == "SILVER" or tU == "SI1!"
        r := "SILVER"
    else if tU == "XCUUSD" or tU == "COPPER" or tU == "HG1!"
        r := "COPPER"
    else if tU == "XPTUSD" or tU == "PLATINUM" or tU == "PL1!"
        r := "PLATINUM"
    else if tU == "XPDUSD" or tU == "PALLADIUM" or tU == "PA1!"
        r := "PALLADIUM"
    else if tU == "WTICOUSD" or tU == "USOIL" or tU == "WTI" or tU == "CL1!"
        r := "WTI"
    else if tU == "BCOUSD" or tU == "UKOIL" or tU == "BRENT" or tU == "BRN1!" or tU == "BZ1!"
        r := "BRENT"
    else if tU == "NATGASUSD" or tU == "NATGAS" or tU == "NG1!"
        r := "NATGAS"
    else if tU == "SOYBNUSD" or tU == "SOYBEAN" or tU == "ZS1!"
        r := "SOYBEAN"
    else if tU == "CORNUSD" or tU == "CORN" or tU == "ZC1!"
        r := "CORN"
    else if tU == "WHEATUSD" or tU == "WHEAT" or tU == "ZW1!"
        r := "WHEAT"
    else if tU == "SUGARUSD" or tU == "SUGAR" or tU == "SB1!"   // vol zones only (ICE — no OI)
        r := "SUGAR"
    r

if barstate.isfirst
    array<string> lines = str.split(pasteTxt, "\n")
    int n = array.size(lines)
    // pass 1 — find instrument blocks: a short line with no '|' that is not a title/note line
    array<string> bName = array.new_string()
    array<int> bStart = array.new_int()
    if n > 0
        for i = 0 to n - 1
            string ln = str.trim(array.get(lines, i))
            if str.length(ln) >= 2 and str.length(ln) <= 14 and not str.contains(ln, "|") and not str.startswith(ln, "─") and not str.startswith(ln, "Generated") and not str.startswith(ln, "Reading") and not str.startswith(ln, "Omitted")
                array.push(bName, str.upper(ln))
                array.push(bStart, i)
    int nb = array.size(bName)
    if nb == 0
        parseNote := "Paste the OI Profile export into the indicator settings (1 · Data)."
    else
        string want = str.upper(overrideKey) != "" ? str.upper(overrideKey) : str.upper(f_normaliseTicker(syminfo.ticker, goldChart, nqChart, spxChart, de30Chart, uk100Chart, us30Chart, us2kChart))
        int pick = -1
        for b = 0 to nb - 1
            if array.get(bName, b) == want
                pick := b
        // never draw ANOTHER instrument's levels on this chart: with a single pasted block use it (note the name), with several require a match
        if pick < 0 and nb == 1
            pick := 0
        if pick < 0
            string have = ""
            for b = 0 to nb - 1
                have += (b > 0 ? ", " : "") + array.get(bName, b)
            parseNote := "No block for " + want + " in this paste (have: " + have + "). Set 'Instrument' in settings or paste that instrument."
        else
            if array.get(bName, pick) != want
                parseNote := "Pasted block is " + array.get(bName, pick) + " but the chart looks like " + want + " — showing it anyway."
            int s0 = array.get(bStart, pick) + 1
            int s1 = pick + 1 < nb ? array.get(bStart, pick + 1) : n
            mName := array.get(bName, pick)
            // header line (Generated: …) is above the first name line
            for i = 0 to n - 1
                string ln2 = str.trim(array.get(lines, i))
                if str.startswith(ln2, "Generated:")
                    mGen := str.trim(str.replace(ln2, "Generated:", ""))
            // pass 2 — parse the chosen block
            if s1 > s0
                for i = s0 to s1 - 1
                    string ln3 = str.trim(array.get(lines, i))
                    if str.length(ln3) > 2
                        array<string> p = str.split(ln3, "|")
                        string tag = array.get(p, 0)
                        if tag == "M"
                            int np = array.size(p)
                            for j = 1 to np - 2 by 2
                                string key = array.get(p, j)
                                string val = array.get(p, j + 1)
                                if key == "spot"
                                    mSpot := str.tonumber(val)
                                else if key == "regime"
                                    mRegime := val
                                else if key == "netgex"
                                    mNet := str.tonumber(val)
                                else if key == "book"
                                    mBook := val
                                else if key == "bookpct"
                                    mBookPct := str.tonumber(val)
                                else if key == "zg"
                                    mZg := str.tonumber(val)
                                else if key == "flip"
                                    mFlip := str.tonumber(val)
                                else if key == "em_hi"
                                    mEmHi := str.tonumber(val)
                                else if key == "em_lo"
                                    mEmLo := str.tonumber(val)
                                else if key == "empct"
                                    mEmPct := str.tonumber(val)
                                else if key == "iv"
                                    mIv := str.tonumber(val)
                                else if key == "rr"
                                    mRr := str.tonumber(val)
                                else if key == "refmove"
                                    mRef := str.tonumber(val)
                                else if key == "binw"
                                    mBinw := str.tonumber(val)
                                else if key == "vegapk"
                                    mVegaPk := str.tonumber(val)
                                else if key == "terms"
                                    mTerms := val
                                else if key == "saved"
                                    mSaved := val
                                else if key == "sig"
                                    mSig := str.tonumber(val)
                                else if key == "gpsince"
                                    mGpSince := str.tonumber(val)
                        else if tag == "H0"
                            mUp1 := f_num(p, 2)
                            mDn1 := f_num(p, 4)
                        else if tag == "L"
                            array.push(lvType, f_str(p, 1))
                            array.push(lvPrice, f_num(p, 2))
                            array.push(lvLabel, f_str(p, 3))
                            array.push(lvStr, f_num(p, 4))
                            array.push(lvTouch, f_num(p, 5))
                            array.push(lvEta, f_num(p, 6))
                            array.push(lvExp, f_str(p, 7))
                            array.push(lvChg, f_num(p, 8))
                        else if tag == "G"
                            array.push(gP, f_num(p, 1))
                            array.push(gN, f_num(p, 2))
                        else if tag == "V"
                            array.push(vP, f_num(p, 1))
                            array.push(vV, f_num(p, 2))
                        else if tag == "O"
                            array.push(oP, f_num(p, 1))
                            array.push(oV, f_num(p, 2))
                        else if tag == "C"
                            array.push(cP, f_num(p, 1))
                            array.push(cV, f_num(p, 2))
                        else if tag == "W"
                            array.push(wP, f_num(p, 1))
                            array.push(wV, f_num(p, 2))
            parsed := array.size(lvPrice) > 0 or array.size(gP) > 0


tblTextSize = tblSize == "small" ? size.small : size.tiny

// ── Helpers ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────
f_lvCol(t) =>
    t == "call_wall" ? cCall : t == "put_wall" ? cPut : t == "zero_gamma" or t == "gex_flip" ? cZero : t == "max_pain" ? cPain : t == "vanna_flip" ? cVanna : t == "charm_flip" ? cCharm : t == "oi_volume" ? cVol : t == "gamma_peak" or t == "short_gamma_node" or t == "long_gamma_node" ? cPeak : cEM

f_lvStyle(t) =>
    t == "max_pain" ? line.style_dashed : t == "zero_gamma" or t == "gex_flip" or t == "vanna_flip" or t == "charm_flip" ? line.style_dotted : t == "exp_hi" or t == "exp_lo" ? line.style_dashed : line.style_solid

f_lblSize() =>
    lblSizeIn == "tiny" ? size.tiny : lblSizeIn == "normal" ? size.normal : size.small


// What the next (or current) touch did in the oi-profile-lines data, by the level's path so far today (H held, B broke, ? both on one bar).
// Returns [short label text, table text, kind]: kind 1 = hold lean (★ candidate), -1 = break lean (hint), 0 = no edge.
f_read(string path, bool gpPin, bool gpSpent) =>
    string sh = "50/50"
    string lg = ""
    int kind = 0
    if gpPin
        sh := "★ HOLD lean 70%"
        lg := "★ HOLD lean: gamma peak, PIN day, 1st touch held 70% vs 49% at fake lines (n 74; candidate, scored forward)"
        kind := 1
    else if str.contains(path, "?")
        lg := "50/50 · a touch went both ways on one bar; no data for this path"
    else if path == ""
        lg := "50/50 · 1st touches held 49% (fake lines 48.5%)"
    else if path == "H"
        lg := "50/50 · 2nd touch after a hold held 51% (fake 51%)"
    else if path == "B"
        lg := "50/50 · retest after a break held 48.5% (fake 50.6%)"
    else if path == "HH"
        lg := "50/50 · 3rd touch after two holds held 50% (fake 49%)"
    else if path == "HB"
        sh := "break lean (hint)"
        lg := "break lean, hint only: 3rd touch after held→broke held 36% vs 47% at fake lines (n 122, CI touches 0; scored forward)"
        kind := -1
    else if path == "BH"
        lg := "50/50 · 3rd touch after broke→held held 50% (fake 46%)"
    else if path == "BB"
        lg := "50/50 · 3rd touch after two breaks held 55% (fake 46%, not significant)"
    else
        lg := "50/50 · 4th touch or later: too few in our data"
    if gpSpent and kind == 0
        lg := lg + " · gamma peak already touched (later touches held 49%)"
    [sh, lg, kind]

f_state(int tch, int pend, string seq) =>
    int nH = 0
    int nB = 0
    for ch in str.split(seq, "")
        if ch == "H"
            nH += 1
        else if ch == "B"
            nB += 1
    string rec = (nH > 0 ? "held ×" + str.tostring(nH) : "") + (nH > 0 and nB > 0 ? ", " : "") + (nB > 0 ? "broke ×" + str.tostring(nB) : "")
    pend != 0 ? "testing now (touch " + str.tostring(tch) + ")" + (rec != "" ? " · " + rec : "") : tch == 0 ? "untouched" : (rec != "" ? rec : "chop")

f_arrMax(a) =>
    float m = na
    if array.size(a) > 0
        m := array.max(a)
    m

f_arrMin(a) =>
    float m = na
    if array.size(a) > 0
        m := array.min(a)
    m

f_absMax(a) =>
    float m = 0.0
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            float v = array.get(a, i)
            if not na(v)
                m := math.max(m, math.abs(v))
    m

// ── London-day anchor (runs every bar): the first bar of the current Europe/London calendar day ────────────────────────────────
var int dayFirst = 0
if na(time[1]) or dayofmonth(time, "Europe/London") != dayofmonth(time[1], "Europe/London")
    dayFirst := bar_index

// ── Drawing (last bar only; everything is deleted and redrawn) ──────────────────────────────────────────────────────────────
var array<box> dBox = array.new<box>()
var array<line> dLine = array.new<line>()
var array<label> dLbl = array.new<label>()
var array<polyline> dPoly = array.new<polyline>()
var table tbl = na

if barstate.islast
    // clear the previous frame
    if array.size(dBox) > 0
        for i = 0 to array.size(dBox) - 1
            box.delete(array.get(dBox, i))
        array.clear(dBox)
    if array.size(dLine) > 0
        for i = 0 to array.size(dLine) - 1
            line.delete(array.get(dLine, i))
        array.clear(dLine)
    if array.size(dLbl) > 0
        for i = 0 to array.size(dLbl) - 1
            label.delete(array.get(dLbl, i))
        array.clear(dLbl)
    if array.size(dPoly) > 0
        for i = 0 to array.size(dPoly) - 1
            polyline.delete(array.get(dPoly, i))
        array.clear(dPoly)
    table.delete(tbl)

    // a block whose spot is nowhere near this chart's price (NQ pasted on a gold chart) would draw far off-screen and look like "nothing"; say so instead
    bool spotOk = na(mSpot) or close <= 0 or math.abs(mSpot / close - 1) <= 0.25
    string msg = not parsed ? (parseNote != "" ? parseNote : "OI Profile: no data parsed — paste the export in settings (1 · Data).") : (spotOk ? "" : "Pasted " + mName + " block (spot " + str.tostring(mSpot, format.mintick) + ") does not match this chart (price " + str.tostring(close, format.mintick) + "). Check the chart symbol and the Symbol Mapping boxes, or paste that instrument.")
    if not parsed or not spotOk
        tbl := table.new(tblPosition, 1, 1, bgcolor=color.new(#0d1117, 8), frame_color=color.new(#f0b04a, 0), frame_width=1)
        table.cell(tbl, 0, 0, msg, text_color=color.new(#f0b04a, 0), text_size=size.normal, text_halign=text.align_left)
        array.push(dLbl, label.new(x=bar_index, y=close, text="OI PROFILE: " + msg, xloc=xloc.bar_index, yloc=yloc.price, color=color.new(#0d1117, 5), style=label.style_label_left, textcolor=color.new(#f0b04a, 0), size=size.small))
    else
        int bi = bar_index
        int hw = int(math.round(colW / 2.0))
        bool anchorDay = lineStart == "London midnight" and timeframe.isintraday
        int xStart = anchorDay ? dayFirst : bi - 120    // where every line and zone starts
        float tfMs = timeframe.in_seconds() * 1000.0
        int dayEndT = timestamp("Europe/London", year(time, "Europe/London"), month(time, "Europe/London"), dayofmonth(time, "Europe/London") + 1, 0, 0)
        int barsLeft = (lineEnd == "London midnight" and timeframe.isintraday and tfMs > 0) ? math.max(0, int(math.round((dayEndT - time) / tfMs))) : 0
        int xL = bi + barsLeft + gapBars            // where the profile panel starts
        int xLineEnd = xL - (barsLeft > 0 ? gapBars : 0)   // where lines stop
        int c0 = xL + hw                             // GEX centre
        int c1 = c0 + colW + colGap                  // vanna centre
        int c2 = c1 + colW + colGap                  // volume centre
        int c3 = showChg ? c2 + colW + colGap : c2    // OI-change centre (the column only takes room when shown)
        int c3w = showVega ? c3 + colW + colGap : c3  // vega centre (the column only takes room when shown; one-sided bars start at c3w - hw)
        float ref = na(mRef) ? math.max(syminfo.mintick * 50, (nz(f_arrMax(gP), close) - nz(f_arrMin(gP), close)) / 6.4) : mRef
        float pTop = nz(f_arrMax(gP), close + 2 * ref)
        float pBot = nz(f_arrMin(gP), close - 2 * ref)
        if array.size(lvPrice) > 0
            pTop := math.max(pTop, f_arrMax(lvPrice))
            pBot := math.min(pBot, f_arrMin(lvPrice))
        float halfBin = (na(mBinw) or mBinw <= 0) ? ref / 40.0 : mBinw / 2.0

        // ── expected-move box ──
        if showEM and not na(mEmHi) and not na(mEmLo)
            array.push(dBox, box.new(left=xStart, top=mEmHi, right=xL - 1, bottom=mEmLo, border_color=color.new(cEM, 55), border_style=line.style_dashed, border_width=1, bgcolor=color.new(cEM, 93)))
            array.push(dLbl, label.new(x=xL - 1, y=mEmHi, text="EXPECTED MOVE  ±" + str.tostring((mEmHi - mEmLo) / 2, format.mintick) + (na(mEmPct) ? "" : "  (" + str.tostring(mEmPct, "#.##") + "%)"), xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.black, 100), style=label.style_label_down, textcolor=cEM, size=size.tiny, textalign=text.align_right))

        // ── levels: keep the most important N, then (optional band), line, label chip (de-overlapped in price) ──
        int nL = array.size(lvPrice)
        float lastY = na
        string nxtUp = ""
        string nxtDn = ""
        float nxtUpP = na
        float nxtDnP = na
        int nHeldDay = 0
        int nBrokeDay = 0
        bool labLeft = labelSide == "left"
        int labX = labLeft ? xStart : xL
        if nL > 0
            // importance: walls / zero gamma / GEX flip / max pain / the day's edges first; vanna, charm, volume, gamma peak only when ticked
            array<float> score = array.new_float()
            for i = 0 to nL - 1
                string t0 = array.get(lvType, i)
                float s0 = nz(array.get(lvStr, i), 0.5)
                // on a PIN day the gamma peak is the one line with a candidate read, so it is always shown when the touch read is on
                bool isMinor = t0 == "vanna_flip" or t0 == "charm_flip" or t0 == "oi_volume" or (t0 == "gamma_peak" and not (showRead and mRegime == "PIN"))
                float sc = t0 == "zero_gamma" ? 95.0 : (t0 == "call_wall" or t0 == "put_wall") ? 80.0 + 20.0 * s0 : t0 == "gex_flip" ? 85.0 : t0 == "max_pain" ? 82.0 : (t0 == "exp_hi" or t0 == "exp_lo") ? 70.0 : (t0 == "short_gamma_node" or t0 == "long_gamma_node") ? 76.0 + 14.0 * s0 : 30.0 + 20.0 * s0
                bool isEm = t0 == "exp_hi" or t0 == "exp_lo"
                array.push(score, ((isMinor and not showMinor) or isEm) ? -1.0 : sc)
            array<bool> sel = array.new_bool(nL, false)
            array<int> ord = array.new_int()   // selected levels, most important first: the leader of a cluster is always its strongest member
            for k = 1 to maxLevels
                int bestI = -1
                float bestS = -0.5
                for i = 0 to nL - 1
                    if not array.get(sel, i) and array.get(score, i) > bestS
                        bestS := array.get(score, i)
                        bestI := i
                if bestI >= 0
                    array.set(sel, bestI, true)
                    array.push(ord, bestI)
            if showEM
                for i = 0 to nL - 1
                    string te = array.get(lvType, i)
                    if (te == "exp_hi" or te == "exp_lo") and not array.get(sel, i)
                        array.set(sel, i, true)
                        array.push(ord, i)
            float gap = ref * 0.11
            // levels at (nearly) the same price get ONE line, ONE zone and ONE label naming them all (strongest first), so stacked bands and
            // labels never pile up. "Nearly" = within a zone's own half-height, so two zones that would overlap become one.
            float clusterTol = ref * math.max(0.02, zoneFrac)
            array<int> lead = array.new_int(nL, -1)
            array<string> also = array.new_string(nL, "")
            if array.size(ord) > 1
                for a = 1 to array.size(ord) - 1
                    int i = array.get(ord, a)
                    for b = 0 to a - 1
                        int j = array.get(ord, b)
                        if array.get(lead, j) == -1 and math.abs(array.get(lvPrice, j) - array.get(lvPrice, i)) <= clusterTol
                            array.set(lead, i, j)
                            array.set(also, j, array.get(also, j) + " · " + array.get(lvLabel, i))
                            break
            // ── touch read: replay today's bars at every level (oi-profile-lines rules: arm on a close 0.25σ away, touch at the level, then
            //    held = 0.25σ back before 0.25σ through; the touch bar can only resolve as a break; a bar that does both = "?") ──
            int nbT = timeframe.isintraday ? math.min(1999, bi - dayFirst + 1) : 0
            bool readOn = showRead and not na(mSig) and mSig > 0 and nbT > 0
            // the ★ was only ever scored on a book captured this morning: gpsince must be today's London date
            bool capToday = not na(mGpSince) and dayofmonth(int(mGpSince), "Europe/London") == dayofmonth(time, "Europe/London") and month(int(mGpSince), "Europe/London") == month(time, "Europe/London")
            array<int> rTch = array.new_int(nL, 0)
            array<int> rPend = array.new_int(nL, 0)
            array<int> rBt = array.new_int(nL, 0)
            array<string> rSeq = array.new_string(nL, "")
            array<bool> rGp = array.new_bool(nL, false)
            if readOn
                float kR = 0.25 * mSig
                for i = 0 to nL - 1
                    if array.get(sel, i) and array.get(lead, i) == -1
                        float p = array.get(lvPrice, i)
                        bool g = false
                        for j2 = 0 to nL - 1
                            if array.get(lvType, j2) == "gamma_peak" and math.abs(array.get(lvPrice, j2) - p) <= 0.05 * mSig
                                g := true
                        array.set(rGp, i, g)
                        int armed = 0
                        int pend = 0
                        int tch = 0
                        int bt = 0
                        string seq = ""
                        for j = nbT - 1 to 0
                            float bh = high[j]
                            float bl = low[j]
                            float bc = close[j]
                            if pend != 0
                                bool back = pend == 1 ? bh >= p + kR : bl <= p - kR
                                bool thru = pend == 1 ? bl <= p - kR : bh >= p + kR
                                if back or thru
                                    seq += back and thru ? "?" : thru ? "B" : "H"
                                    pend := 0
                            else if armed != 0
                                bool hit = armed == 1 ? bl <= p : bh >= p
                                if hit
                                    tch += 1
                                    bt += capToday and time[j] >= mGpSince ? 1 : 0
                                    pend := armed
                                    armed := 0
                                    if (pend == 1 ? bl <= p - kR : bh >= p + kR)
                                        seq += "B"
                                        pend := 0
                            if pend == 0
                                if bc >= p + kR
                                    armed := 1
                                else if bc <= p - kR
                                    armed := -1
                        array.set(rTch, i, tch)
                        array.set(rPend, i, pend)
                        array.set(rBt, i, bt)
                        array.set(rSeq, i, seq)
            for i = 0 to nL - 1
                if array.get(sel, i) and array.get(lead, i) == -1
                    string t = array.get(lvType, i)
                    float p = array.get(lvPrice, i)
                    color col = f_lvCol(t)
                    float strn = nz(array.get(lvStr, i), 0.5)
                    bool isEdge = t == "exp_hi" or t == "exp_lo"
                    int nStack = 1                  // how many levels share this line (1 = alone)
                    for j = 0 to nL - 1
                        if array.get(lead, j) == i
                            nStack += 1
                    if showZones and not isEdge
                        float zh = ref * zoneFrac * (0.6 + 0.8 * strn)
                        array.push(dBox, box.new(left=xStart, top=p + zh, right=xLineEnd, bottom=p - zh, border_color=color(na), bgcolor=color.new(col, 92)))
                    if showLevels
                        int wdt = isEdge ? 1 : math.min(5, 1 + int(math.round(strn * 2)) + (nStack - 1))   // a stacked line is one pixel thicker per extra level
                        array.push(dLine, line.new(x1=xStart, y1=p, x2=xLineEnd, y2=p, xloc=xloc.bar_index, color=color.new(col, nStack > 1 ? 0 : 25), style=f_lvStyle(t), width=wdt))
                        float ly = na(lastY) ? p : math.min(p, lastY - gap)
                        lastY := ly
                        float tp = array.get(lvTouch, i)
                        float et = array.get(lvEta, i)
                        string rdTxt = ""
                        if readOn and not isEdge
                            string sq = array.get(rSeq, i)
                            int tc = array.get(rTch, i)
                            int pd = array.get(rPend, i)
                            bool gpPin = array.get(rGp, i) and mRegime == "PIN" and capToday and array.get(rBt, i) == 0
                            bool gpSpent = array.get(rGp, i) and mRegime == "PIN" and array.get(rBt, i) > 0
                            [rSh, rLg, rK] = f_read(sq, gpPin, gpSpent)
                            string st = f_state(tc, pd, sq)
                            rdTxt := "\n" + st + " → " + (pd != 0 ? "this touch: " : "next touch: ") + rSh
                            for ch in str.split(sq, "")
                                nHeldDay += ch == "H" ? 1 : 0
                                nBrokeDay += ch == "B" ? 1 : 0
                            string row = str.tostring(p, format.mintick) + " " + array.get(lvLabel, i) + " · " + st + " · " + rLg
                            if p >= close and (na(nxtUpP) or p < nxtUpP)
                                nxtUpP := p
                                nxtUp := row
                            if p < close and (na(nxtDnP) or p > nxtDnP)
                                nxtDnP := p
                                nxtDn := row
                        string txt = (nStack > 1 ? "×" + str.tostring(nStack) + " " : "") + array.get(lvLabel, i) + array.get(also, i) + "  " + str.tostring(p, format.mintick) + (array.get(lvExp, i) != "" ? "  ·  " + array.get(lvExp, i) : "") + (f_chgChip(i)) + (na(tp) ? "" : "  ·  " + str.tostring(tp, "#") + "%" + (na(et) ? "" : "~" + str.tostring(et, "#") + "m")) + rdTxt
                        array.push(dLbl, label.new(x=labX, y=ly, text=txt, xloc=xloc.bar_index, yloc=yloc.price, color=color.new(#0d1117, 12), style=(labLeft ? label.style_label_right : label.style_label_left), textcolor=col, size=f_lblSize()))
                        // a label that had to be moved to clear its neighbour stays tied to its own line by a dotted connector
                        if math.abs(ly - p) > ref * 0.02
                            array.push(dLine, line.new(x1=labX, y1=p, x2=labX, y2=ly, xloc=xloc.bar_index, color=color.new(col, 30), style=line.style_dotted, width=1))

        // ── column titles + spines ──
        float yT = pTop + ref * 0.12
        if showGex
            array.push(dLbl, label.new(x=c0, y=yT, text="GEX PROFILE", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.black, 100), style=label.style_label_center, textcolor=color.new(#8b95a3, 0), size=size.tiny))
            array.push(dLine, line.new(x1=c0, y1=pBot, x2=c0, y2=pTop, xloc=xloc.bar_index, color=color.new(#2a3340, 0), width=1))
        if showVanna
            array.push(dLbl, label.new(x=c1, y=yT, text="VANNA", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.black, 100), style=label.style_label_center, textcolor=color.new(#8b95a3, 0), size=size.tiny))
            array.push(dLine, line.new(x1=c1, y1=pBot, x2=c1, y2=pTop, xloc=xloc.bar_index, color=color.new(#2a3340, 0), width=1))
        if showVol
            array.push(dLbl, label.new(x=c2, y=yT, text="VOLUME", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.black, 100), style=label.style_label_center, textcolor=color.new(#8b95a3, 0), size=size.tiny))
            array.push(dLine, line.new(x1=c2 - hw, y1=pBot, x2=c2 - hw, y2=pTop, xloc=xloc.bar_index, color=color.new(#2a3340, 0), width=1))
        if showChg
            array.push(dLbl, label.new(x=c3, y=yT, text="OI CHG", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.black, 100), style=label.style_label_center, textcolor=color.new(#8b95a3, 0), size=size.tiny))
            array.push(dLine, line.new(x1=c3, y1=pBot, x2=c3, y2=pTop, xloc=xloc.bar_index, color=color.new(#2a3340, 0), width=1))
        if showVega
            array.push(dLbl, label.new(x=c3w, y=yT, text="VEGA", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.black, 100), style=label.style_label_center, textcolor=color.new(#8b95a3, 0), size=size.tiny))
            array.push(dLine, line.new(x1=c3w - hw, y1=pBot, x2=c3w - hw, y2=pTop, xloc=xloc.bar_index, color=color.new(#2a3340, 0), width=1))

        // ── GEX profile bars (sqrt scale so small strikes still read) ──
        if showGex and array.size(gP) > 0
            float gmax = f_absMax(gN)
            if gmax > 0
                for i = 0 to array.size(gP) - 1
                    float v = array.get(gN, i)
                    float r = math.sqrt(math.abs(v) / gmax)
                    int len = int(math.round(r * hw))
                    if len >= 1
                        float py = array.get(gP, i)
                        color bc = v > 0 ? cPut : cCall
                        array.push(dBox, box.new(left=v > 0 ? c0 : c0 - len, top=py + halfBin * 0.8, right=v > 0 ? c0 + len : c0, bottom=py - halfBin * 0.8, border_color=color(na), bgcolor=color.new(bc, 55 - int(r * 40))))

        // ── vanna bars ──
        if showVanna and array.size(vP) > 0
            float vmax = f_absMax(vV)
            if vmax > 0
                for i = 0 to array.size(vP) - 1
                    float v = array.get(vV, i)
                    int len = int(math.round(math.abs(v) / vmax * hw))
                    if len >= 1
                        float py = array.get(vP, i)
                        array.push(dBox, box.new(left=v > 0 ? c1 : c1 - len, top=py + halfBin * 0.5, right=v > 0 ? c1 + len : c1, bottom=py - halfBin * 0.5, border_color=color(na), bgcolor=color.new(v > 0 ? #38bdf8 : cVanna, 25)))

        // ── volume bars ──
        if showVol and array.size(oP) > 0
            float omax = f_absMax(oV)
            if omax > 0
                for i = 0 to array.size(oP) - 1
                    float v = array.get(oV, i)
                    int len = int(math.round(v / omax * colW))
                    if len >= 1
                        float py = array.get(oP, i)
                        array.push(dBox, box.new(left=c2 - hw, top=py + halfBin * 0.5, right=c2 - hw + len, bottom=py - halfBin * 0.5, border_color=color(na), bgcolor=color.new(cVol, 30)))

        // ── OI change bars: green right = contracts added, red left = contracts closed ──
        if showChg and array.size(cP) > 0
            float cmax = f_absMax(cV)
            if cmax > 0
                for i = 0 to array.size(cP) - 1
                    float v = array.get(cV, i)
                    int len = int(math.round(math.abs(v) / cmax * hw))
                    if len >= 1
                        float py = array.get(cP, i)
                        array.push(dBox, box.new(left=v > 0 ? c3 : c3 - len, top=py + halfBin * 0.5, right=v > 0 ? c3 + len : c3, bottom=py - halfBin * 0.5, border_color=color(na), bgcolor=color.new(v > 0 ? cPut : cCall, 30)))

        // ── vega bars: gross, one-sided from the column's left edge; the biggest strike is brightest ──
        if showVega and array.size(wP) > 0
            float wmax = f_absMax(wV)
            if wmax > 0
                for i = 0 to array.size(wP) - 1
                    float v = array.get(wV, i)
                    int len = int(math.round(v / wmax * colW))
                    if len >= 1
                        float py = array.get(wP, i)
                        array.push(dBox, box.new(left=c3w - hw, top=py + halfBin * 0.5, right=c3w - hw + len, bottom=py - halfBin * 0.5, border_color=color(na), bgcolor=color.new(cVega, 70 - int(v / wmax * 45))))

        // ── summary table ──
        if showTable
            tbl := table.new(tblPosition, 2, 14, bgcolor=color.new(#0d1117, 6), frame_color=color.new(#2a3340, 0), frame_width=1, border_width=0)
            color rc = mRegime == "BREAKOUT" ? cCall : cPut
            table.cell(tbl, 0, 0, "OI PROFILE · " + mName + (mTerms == "futures" ? " · futures prices" : " · spot/CFD prices"), text_color=color.new(#e6e9ef, 0), text_size=tblTextSize, text_halign=text.align_left)
            table.cell(tbl, 1, 0, mGen == "" ? "" : str.substring(mGen, 0, math.min(16, str.length(mGen))), text_color=color.new(#8b95a3, 0), text_size=size.tiny, text_halign=text.align_right)
            table.cell(tbl, 0, 1, "REGIME", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 1, mRegime == "BREAKOUT" ? "BREAKOUT · short gamma" : "PIN · long gamma", text_color=rc, text_size=tblTextSize, text_halign=text.align_right)
            table.cell(tbl, 0, 2, "STRONGEST DTE", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 2, mBook + (na(mBookPct) ? "" : "  " + str.tostring(mBookPct, "#") + "% of gamma"), text_color=cPain, text_size=tblTextSize, text_halign=text.align_right)
            table.cell(tbl, 0, 3, "ZERO GAMMA", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 3, na(mZg) ? "—" : str.tostring(mZg, format.mintick) + "  (" + (mZg >= close ? "+" : "") + str.tostring(mZg - close, format.mintick) + ")", text_color=cZero, text_size=tblTextSize, text_halign=text.align_right)
            table.cell(tbl, 0, 4, "EXP MOVE", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 4, na(mEmHi) ? "—" : "±" + str.tostring((mEmHi - mEmLo) / 2, format.mintick) + (na(mEmPct) ? "" : "  (" + str.tostring(mEmPct, "#.##") + "%)"), text_color=cEM, text_size=tblTextSize, text_halign=text.align_right)
            table.cell(tbl, 0, 5, "ATM IV · RR", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 5, (na(mIv) ? "—" : str.tostring(mIv, "#.#") + "%") + (na(mRr) ? "" : "  ·  " + str.tostring(mRr, "#.#")), text_color=cSmile, text_size=tblTextSize, text_halign=text.align_right)
            table.cell(tbl, 0, 6, "HEDGE ±1%", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 6, na(mUp1) ? "—" : "↑ " + str.tostring(mUp1, "#") + " · ↓ " + str.tostring(mDn1, "#") + " contracts", text_color=color.new(#cbd5e1, 0), text_size=tblTextSize, text_halign=text.align_right)
            // freshness: how old this paste is, and how long the gamma it describes lasts (the strongest-DTE book decides)
            float ageH = na
            string ageSrc = str.length(mSaved) >= 16 ? mSaved : mGen
            if str.length(ageSrc) >= 16
                ageH := (timenow - timestamp("UTC", int(str.tonumber(str.substring(ageSrc, 0, 4))), int(str.tonumber(str.substring(ageSrc, 5, 7))), int(str.tonumber(str.substring(ageSrc, 8, 10))), int(str.tonumber(str.substring(ageSrc, 11, 13))), int(str.tonumber(str.substring(ageSrc, 14, 16))), 0)) / 3600000.0
            color ageCol = na(ageH) ? color.new(#7d8896, 0) : ageH <= 12 ? cPut : ageH <= 30 ? cEM : cCall
            string shelf = str.startswith(mBook, "0") ? "most of this gamma expires within a day" : str.startswith(mBook, "2") ? "lasts a few days (2–7 DTE book)" : "lasts a week or more; re-paste daily"
            table.cell(tbl, 0, 7, "OI DATA AGE", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 7, na(ageH) ? "—" : str.tostring(ageH, "#.#") + " h ago" + (ageH > 30 ? " — re-paste" : ""), text_color=ageCol, text_size=tblTextSize, text_halign=text.align_right)
            table.cell(tbl, 0, 8, "SHELF LIFE", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 8, shelf, text_color=color.new(#cbd5e1, 0), text_size=tblTextSize, text_halign=text.align_right)
            table.cell(tbl, 0, 9, "VEGA PEAK", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 9, na(mVegaPk) ? "—" : str.tostring(mVegaPk, format.mintick) + "  (" + (mVegaPk >= close ? "+" : "") + str.tostring(mVegaPk - close, format.mintick) + ")", text_color=cVega, text_size=tblTextSize, text_halign=text.align_right)
            // touch read: the nearest shown level each side, today's record there, and what its next touch did in our data
            string noRead = not showRead ? "touch read off" : (na(mSig) or mSig <= 0) ? "re-export: this paste has no sig (needed for the touch read)" : not timeframe.isintraday ? "intraday charts only" : "—"
            color upCol = str.contains(nxtUp, "★") ? cPain : str.contains(nxtUp, "break lean") ? cCall : color.new(#cbd5e1, 0)
            color dnCol = str.contains(nxtDn, "★") ? cPain : str.contains(nxtDn, "break lean") ? cCall : color.new(#cbd5e1, 0)
            table.cell(tbl, 0, 10, "NEXT ABOVE", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 10, nxtUp != "" ? nxtUp : noRead, text_color=upCol, text_size=tblTextSize, text_halign=text.align_right)
            table.cell(tbl, 0, 11, "NEXT BELOW", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 11, nxtDn != "" ? nxtDn : noRead, text_color=dnCol, text_size=tblTextSize, text_halign=text.align_right)
            table.cell(tbl, 0, 12, "TODAY AT LEVELS", text_color=color.new(#7d8896, 0), text_size=size.tiny, text_halign=text.align_left)
            table.cell(tbl, 1, 12, "held " + str.tostring(nHeldDay) + " · broke " + str.tostring(nBrokeDay) + (mRegime == "PIN" and na(mGpSince) ? " · ★ needs this morning's OI capture" : ""), text_color=color.new(#cbd5e1, 0), text_size=tblTextSize, text_halign=text.align_right)
            table.cell(tbl, 0, 13, "13k touches: these lines held 49%, the same as fake lines nearby; ★ and the hint are candidates scored forward, not signals", text_color=color.new(#5b6678, 0), text_size=size.tiny, text_halign=text.align_left)
            table.merge_cells(tbl, 0, 13, 1, 13)
