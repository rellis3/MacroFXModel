//@version=6
// Exhaustion Zones (shadow ladder-v2) — paste the EXHAUSTION export (scripts/ladder-v2/export_exhaustion.py).
// For each OH/OL line (p50/p75/p90, % of the London-midnight open) it draws:
//   - the line
//   - an inner zone: line -> + median run-past before the first 0.25σ pullback (darker)
//   - an outer zone: -> + 75th-percentile run-past (lighter)
//   - a label with the chance a touch NOW goes on to the next line (p90: a further 0.25σ), from the current
//     London time bucket (00-07 / 07-12 / 12-16 / 16-22).
// Inverted futures (6J / 6S / 6C) draw the export's OH lines below the open and OL above (1/x swaps up and down).
// Research behind it: reversal-zones (zones are how price behaves past ANY level, not a line effect) and
// exhaustion-v2 (next-line odds fall through the day). Shadow only.
indicator("Exhaustion Zones (ladder-v2 shadow)", overlay=true, max_lines_count=100, max_boxes_count=100, max_labels_count=100)

exText = input.text_area("", "Paste EXHAUSTION export")
symSel = input.string("Auto", "Symbol block", tooltip="Auto, or the export block name (e.g. GBPUSD, SPX500, WTI)")
showOuter = input.bool(true, "Show outer (75th) zone")
colUp = input.color(color.new(color.orange, 0), "Upside colour")
colDn = input.color(color.new(color.red, 0), "Downside colour")

f_futuresMap(rt) =>
    string s = ""
    bool inv = false
    // FX — direct quotes
    if rt == "6E" or rt == "M6E" or rt == "E7"
        s := "EURUSD"
    else if rt == "6B" or rt == "M6B"
        s := "GBPUSD"
    else if rt == "6A" or rt == "M6A"
        s := "AUDUSD"
    else if rt == "6N"
        s := "NZDUSD"
    else if rt == "RP"
        s := "EURGBP"
    else if rt == "RY"
        s := "EURJPY"
    else if rt == "RF"
        s := "EURCHF"
    // FX — inverted (USD per foreign unit)
    else if rt == "6J" or rt == "MJY" or rt == "J7"
        s := "USDJPY"
        inv := true
    else if rt == "6S" or rt == "MSF"
        s := "USDCHF"
        inv := true
    else if rt == "6C" or rt == "MCD"
        s := "USDCAD"
        inv := true
    // Metals
    else if rt == "GC" or rt == "MGC" or rt == "1OZ"
        s := "GOLD"
    else if rt == "SI" or rt == "SIL"
        s := "SILVER"
    else if rt == "HG" or rt == "MHG"
        s := "COPPER"
    else if rt == "PL"
        s := "PLATINUM"
    else if rt == "PA"
        s := "PALLADIUM"
    // Energy
    else if rt == "CL" or rt == "MCL" or rt == "QM"
        s := "WTI"
    else if rt == "BZ" or rt == "BRN" or rt == "B"
        s := "BRENT"
    else if rt == "NG" or rt == "QG" or rt == "MNG"
        s := "NATGAS"
    // Grains / softs
    else if rt == "ZS" or rt == "XK"
        s := "SOYBEAN"
    else if rt == "ZW" or rt == "XW"
        s := "WHEAT"
    else if rt == "ZC" or rt == "XC"
        s := "CORN"
    else if rt == "SB"
        s := "SUGAR"
    // Equity indices
    else if rt == "NQ" or rt == "MNQ"
        s := "NQ"
    else if rt == "ES" or rt == "MES"
        s := "SPX500"
    else if rt == "YM" or rt == "MYM"
        s := "US30"
    else if rt == "RTY" or rt == "M2K"
        s := "US2000"
    else if rt == "FDAX" or rt == "FDXM" or rt == "FDXS"
        s := "DE30"
    else if rt == "Z" or rt == "FFI"
        s := "UK100"
    // Crypto
    else if rt == "BTC" or rt == "MBT"
        s := "BTCUSD"
    [s, inv]

f_cleanTicker(t) =>
    u = str.upper(t)
    u := str.replace_all(u, ".", "")
    u := str.replace_all(u, "_", "")
    u := str.replace_all(u, "/", "")
    u := str.replace_all(u, "-", "")
    u := str.replace_all(u, "+", "")
    u := str.replace_all(u, "#", "")
    u := str.replace_all(u, "$", "")
    u

f_cfdMap(u) =>
    string s = ""
    fx = array.from("EURUSD", "GBPUSD", "USDJPY", "AUDUSD", "NZDUSD", "USDCAD", "USDCHF",
         "GBPJPY", "EURGBP", "EURJPY", "EURCHF", "GBPCHF", "AUDJPY", "CADJPY", "EURAUD",
         "EURCAD", "EURNZD", "GBPAUD", "GBPCAD", "AUDCAD", "NZDCAD", "NZDJPY", "BTCUSD",
         "AUDCHF", "AUDNZD", "CADCHF", "CHFJPY", "GBPNZD")
    for p in fx
        if s == "" and str.contains(u, p)
            s := p
    if s == ""
        if str.contains(u, "XAUUSD") or str.startswith(u, "GOLD")
            s := "GOLD"
        else if str.contains(u, "XAGUSD") or str.startswith(u, "SILVER")
            s := "SILVER"
        else if str.contains(u, "XPTUSD") or str.startswith(u, "PLATINUM")
            s := "PLATINUM"
        else if str.contains(u, "XPDUSD") or str.startswith(u, "PALLADIUM")
            s := "PALLADIUM"
        else if str.contains(u, "XCUUSD") or str.startswith(u, "COPPER")
            s := "COPPER"
        else if str.startswith(u, "WTI") or str.startswith(u, "USOIL") or str.startswith(u, "XTIUSD") or str.startswith(u, "CRUDE")
            s := "WTI"
        else if str.startswith(u, "BCO") or str.startswith(u, "UKOIL") or str.startswith(u, "XBRUSD") or str.startswith(u, "BRENT")
            s := "BRENT"
        else if str.startswith(u, "NATGAS") or str.startswith(u, "XNGUSD") or str.startswith(u, "NGAS")
            s := "NATGAS"
        else if str.startswith(u, "SOYB")
            s := "SOYBEAN"
        else if str.startswith(u, "WHEAT")
            s := "WHEAT"
        else if str.startswith(u, "CORN")
            s := "CORN"
        else if str.startswith(u, "SUGAR")
            s := "SUGAR"
        else if str.startswith(u, "NAS100") or str.startswith(u, "US100") or str.startswith(u, "USTEC") or str.startswith(u, "NDX") or str.startswith(u, "USNAS100") or str.startswith(u, "NASDAQ")
            s := "NQ"
        else if str.startswith(u, "SPX500") or str.startswith(u, "US500") or str.startswith(u, "SP500") or str.startswith(u, "SPXUSD")
            s := "SPX500"
        else if str.startswith(u, "GER40") or str.startswith(u, "GER30") or str.startswith(u, "DE40") or str.startswith(u, "DE30") or str.startswith(u, "DAX")
            s := "DE30"
        else if str.startswith(u, "UK100") or str.startswith(u, "FTSE")
            s := "UK100"
        else if str.startswith(u, "US2000") or str.startswith(u, "US2K") or str.startswith(u, "RUSSELL")
            s := "US2000"
        else if str.startswith(u, "US30") or str.startswith(u, "DJ30") or str.startswith(u, "WS30") or str.startswith(u, "DJIA")
            s := "US30"
    s

// [export block, inverted?]: futures by root (6C/6S/6J are quoted the other way up), CFDs by cleaned ticker
f_auto() =>
    string s = ""
    bool inv = false
    if syminfo.type == "futures"
        [fs, fi] = f_futuresMap(str.upper(syminfo.root))
        s := fs
        inv := fi
    if s == ""
        s := f_cfdMap(f_cleanTicker(syminfo.ticker))
    [s, inv]

f_num(string t) =>
    str.tonumber(str.replace_all(str.replace_all(str.trim(t), "%", ""), "+", ""))

// first number in a string
f_first(string src) =>
    float v = na
    parts = str.split(str.trim(src), " ")
    for p in parts
        x = f_num(p)
        if na(v) and not na(x)
            v := x
    v

// all % numbers after the "|" (the four bucket odds)
f_odds(string src) =>
    arr = array.new_float()
    if str.contains(src, "|")
        tail = array.get(str.split(src, "|"), 1)
        for p in str.split(tail, " ")
            if str.endswith(p, "%")
                array.push(arr, f_num(p))
    arr

var string sym = ""
var bool inv = false
var float z50 = na
var float z75 = na
var array<float> lvl = array.new_float(6, na)          // OH50 OH75 OH90 OL50 OL75 OL90 (%)
var matrix<float> odds = matrix.new<float>(6, 4, na)
var array<string> names = array.from("OH p50", "OH p75", "OH p90", "OL p50", "OL p75", "OL p90")

if barstate.isfirst
    [aS, aI] = f_auto()
    sym := symSel == "Auto" ? aS : str.upper(symSel)
    inv := symSel == "Auto" ? aI : false
    bool inBlock = false
    for row in str.split(exText, "\n")
        r = str.trim(row)
        ru = str.upper(r)
        if str.startswith(r, "────")
            inBlock := str.contains(ru, " " + sym + " ")
            continue
        if not inBlock or not str.contains(r, ":")
            continue
        kv = str.split(r, ":")
        key = str.upper(str.trim(array.get(kv, 0)))
        rest = array.get(kv, 1)
        if str.startswith(key, "ZONE")
            z50 := f_first(rest)
            if str.contains(rest, "·")
                z75 := f_first(array.get(str.split(rest, "·"), 1))
        for i = 0 to 5
            if key == str.upper(array.get(names, i))
                array.set(lvl, i, f_first(array.get(str.split(rest, "|"), 0)))
                o = f_odds(rest)
                if array.size(o) > 0
                    for j = 0 to math.min(3, array.size(o) - 1)
                        matrix.set(odds, i, j, array.get(o, j))

// London-midnight session
lonDay = dayofmonth(time, "Europe/London")
newDay = ta.change(lonDay) != 0 or barstate.isfirst
var float dOpen = na
var int t0 = na
var array<line> lns = array.new_line()
var array<box> bxs = array.new_box()
var array<label> lbs = array.new_label()

if newDay and not na(z50) and sym != ""
    for l in lns
        line.delete(l)
    for b in bxs
        box.delete(b)
    for lb in lbs
        label.delete(lb)
    array.clear(lns)
    array.clear(bxs)
    array.clear(lbs)
    dOpen := open
    t0 := time
    t1 = t0 + 22 * 3600 * 1000
    for i = 0 to 5
        p = array.get(lvl, i)
        if not na(p)
            up = (i < 3) != inv            // inverted futures: the export's OH is the chart's downside
            sgn = up ? 1.0 : -1.0
            c = up ? colUp : colDn
            L = dOpen * (1 + sgn * p / 100)
            Li = dOpen * (1 + sgn * (p + z50) / 100)
            Lo = dOpen * (1 + sgn * (p + (na(z75) ? z50 : z75)) / 100)
            array.push(lns, line.new(t0, L, t1, L, xloc=xloc.bar_time, color=c, width=i % 3 == 1 ? 2 : 1))
            array.push(bxs, box.new(t0, math.max(L, Li), t1, math.min(L, Li), xloc=xloc.bar_time, bgcolor=color.new(c, 82), border_color=color.new(c, 100)))
            if showOuter
                array.push(bxs, box.new(t0, math.max(Li, Lo), t1, math.min(Li, Lo), xloc=xloc.bar_time, bgcolor=color.new(c, 93), border_color=color.new(c, 100)))
            array.push(lbs, label.new(t1, L, "", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(c, 85), textcolor=c, size=size.small))

// refresh label text with the current London time bucket
if barstate.islast and array.size(lbs) > 0
    h = hour(time, "Europe/London")
    b = h < 7 ? 0 : h < 12 ? 1 : h < 16 ? 2 : 3
    k = 0
    for i = 0 to 5
        p = array.get(lvl, i)
        if not na(p) and k < array.size(lbs)
            od = matrix.get(odds, i, b)
            word = i % 3 == 2 ? "+0.25σ" : "next"
            label.set_text(array.get(lbs, k), array.get(names, i) + " " + str.tostring(p, "#.##") + "%  " + word + " " + str.tostring(od, "#") + "% now")
            k += 1
