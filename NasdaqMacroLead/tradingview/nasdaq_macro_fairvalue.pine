//@version=6
// Nasdaq Macro Lead - Fair Value (TradingView port)
//
// Pine port of the "fairvalue" variant in js/nasdaqMacroLeadCore.js
// (levelFairValue): a walk-forward LEVEL regression of the chart's own
// close, `horizonBars` bars ahead, on z-scored macro levels — then plotted
// shifted forward in time via plot(..., offset=horizonBars) so the line
// visually leads price, the same effect the Node dashboard's
// scored_path/tail_path split produces.
//
// Two selectable feature sets feed the same regression (see "Feature set"
// input below):
//   - Macro rates: US10Y/US02Y/DXY/GOLD/DFII10/curve slope — the same six
//     factors as the Railway dashboard's fairvalue variant.
//   - Risk appetite: Z(IWM/SPY) + Z(XLY/XLP) + Z(HYG/LQD), a cross-asset
//     small-cap/cyclical/credit composite. NOTE: XLY (consumer
//     discretionary) is heavily weighted with the same mega-cap growth
//     names that dominate NAS100 — some of any correlation here could be
//     structural overlap, not a genuine leading signal. IWM and HYG/LQD
//     are cleaner, more independent legs. Read the correlation gauge with
//     that in mind, don't assume it's a leading indicator just because it
//     tracks.
//
// Macro-rates mode fits US10Y, US02Y, DXY, GOLD, DFII10 AND their own
// slope (US10Y-US02Y) in the same regression — the slope is derived from
// the other two, so they're collinear. A `ridgeFrac` input regularizes
// the fit to keep that from producing huge, unstable coefficients (see
// the comment above matrix.inv() below for what that failure looks like
// and why it's not just a tuning issue).
//
// NOT VERIFIED IN A PINE EDITOR — this session has no way to execute Pine
// Script, so treat this as a first draft to compile and tune by hand, not
// a working artifact. Cross-check ticker availability on your TradingView
// plan; FRED mirror coverage and exchange prefixes (AMEX vs ARCA vs BATS
// for the sector/credit ETFs) can vary. This is a research overlay, not a
// trading signal — see NasdaqMacroLead/README.md for the methodology and
// its honesty checks, only a lightweight rolling-correlation approximation
// of which is reproduced here (see notes at the bottom).

indicator("Nasdaq Macro Lead - Fair Value", shorttitle = "NQ Macro Lead", overlay = true, max_bars_back = 2000)

// ---------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------
modeInput   = input.string("Macro rates", "Feature set", options = ["Macro rates", "Risk appetite"], tooltip = "Macro rates = US10Y/US02Y/DXY/GOLD/DFII10/slope. Risk appetite = Z(IWM/SPY)+Z(XLY/XLP)+Z(HYG/LQD)")
horizonBars = input.int(8, "Horizon (bars ahead)", minval = 1, tooltip = "On an H4 chart, 8≈32h, 9≈36h — matches NasdaqMacroLead's fairvalue variant")
trainBars   = input.int(300, "Training window (bars)", minval = 30, maxval = 500, tooltip = "Rolling OLS fit window. Larger = smoother/slower, smaller = more reactive")
refitEvery  = input.int(20, "Refit every N bars", minval = 1, tooltip = "How often coefficients are re-fit. Inputs still update every bar in between, so the line stays smooth")
zWindow     = input.int(250, "Z-score window (bars)", minval = 20)
corrWindow  = input.int(120, "Rolling correlation window (bars)", minval = 20, tooltip = "Lightweight live honesty gauge — NOT the full IC/null/split-half suite from the Node dashboard")
ridgeFrac   = input.float(0.02, "Ridge regularization (x trainBars)", minval = 0.0, step = 0.005, tooltip = "US10Y, US02Y and their own slope (US10Y-US02Y) are collinear by construction. Without regularization an ill-conditioned fit can return huge, unstable coefficients that blow the chart's scale out — this shrinks the fit instead. Raise if you still see spikes, 0 to disable.")

showBacktest = input.bool(true, "Show backtest overlay (past predictions vs realized price)")

useMacro = modeInput == "Macro rates"
nFeat    = useMacro ? 6 : 3

// ---------------------------------------------------------------------
// Macro-rate feature sources
// ---------------------------------------------------------------------
us10y  = request.security("TVC:US10Y", timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
us02y  = request.security("TVC:US02Y", timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
dxy    = request.security("TVC:DXY",   timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
gold   = request.security("TVC:GOLD",  timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
real10 = request.security("FRED:DFII10", "D", close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
slope  = us10y - us02y

// ---------------------------------------------------------------------
// Risk-appetite feature sources
// ---------------------------------------------------------------------
iwm = request.security("AMEX:IWM", timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
spy = request.security("AMEX:SPY", timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
xly = request.security("AMEX:XLY", timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
xlp = request.security("AMEX:XLP", timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
hyg = request.security("AMEX:HYG", timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
lqd = request.security("AMEX:LQD", timeframe.period, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

max_bars_back(us10y, 2000)
max_bars_back(us02y, 2000)
max_bars_back(dxy, 2000)
max_bars_back(gold, 2000)
max_bars_back(real10, 2000)
max_bars_back(slope, 2000)
max_bars_back(iwm, 2000)
max_bars_back(spy, 2000)
max_bars_back(xly, 2000)
max_bars_back(xlp, 2000)
max_bars_back(hyg, 2000)
max_bars_back(lqd, 2000)

target = close

// ---------------------------------------------------------------------
// Z-scoring (rolling, never looks past the current bar)
// ---------------------------------------------------------------------
z(src) =>
    (src - ta.sma(src, zWindow)) / ta.stdev(src, zWindow)

f1 = z(us10y)
f2 = z(us02y)
f3 = z(dxy)
f4 = z(gold)
f5 = z(real10)
f6 = z(slope)

g1 = z(iwm / spy)
g2 = z(xly / xlp)
g3 = z(hyg / lqd)

// ---------------------------------------------------------------------
// Walk-forward OLS, refit every `refitEvery` bars
//
// Training row k (k = 0 .. trainBars-1) pairs:
//   features known `horizonBars` bars before target time k bars ago
//   -> the realized close at that target time
// i.e. X[k] = features[horizonBars + k] bars back, y[k] = target[k] bars back
// This mirrors nasdaqMacroLeadCore.levelFairValue's training alignment.
// ---------------------------------------------------------------------
var array<float> coefs = array.new<float>(7, 0.0)
var bool haveCoefs = false

minBarsNeeded = trainBars + horizonBars + zWindow

canRefit = bar_index > minBarsNeeded and bar_index % refitEvery == 0

if canRefit
    X = matrix.new<float>(trainBars, nFeat + 1, 1.0)
    y = matrix.new<float>(trainBars, 1, 0.0)
    for k = 0 to trainBars - 1
        if useMacro
            matrix.set(X, k, 0, f1[horizonBars + k])
            matrix.set(X, k, 1, f2[horizonBars + k])
            matrix.set(X, k, 2, f3[horizonBars + k])
            matrix.set(X, k, 3, f4[horizonBars + k])
            matrix.set(X, k, 4, f5[horizonBars + k])
            matrix.set(X, k, 5, f6[horizonBars + k])
        else
            matrix.set(X, k, 0, g1[horizonBars + k])
            matrix.set(X, k, 1, g2[horizonBars + k])
            matrix.set(X, k, 2, g3[horizonBars + k])
        matrix.set(X, k, nFeat, 1.0)
        matrix.set(y, k, 0, target[k])

    Xt    = matrix.transpose(X)
    XtX   = matrix.mult(Xt, X)
    Xty   = matrix.mult(Xt, y)

    // Ridge: add a small term to the diagonal of the FEATURE columns only
    // (never the intercept, at index nFeat, which carries the price level
    // itself and shouldn't be shrunk). This is what
    // nasdaqMacroLeadCore.js's solveLinearSystem gets implicitly from its
    // "near-singular column -> leave as 0" guard on Gaussian elimination;
    // Pine's matrix.inv() has no equivalent protection, so an ill-
    // conditioned XtX (e.g. US10Y/US02Y/slope all in the same fit) can
    // invert "successfully" into huge, unstable coefficients instead of
    // failing cleanly.
    ridgeLambda = ridgeFrac * trainBars
    if ridgeLambda > 0
        for d = 0 to nFeat - 1
            matrix.set(XtX, d, d, matrix.get(XtX, d, d) + ridgeLambda)

    XtXinv = matrix.inv(XtX)

    if not na(XtXinv)
        beta = matrix.mult(XtXinv, Xty)
        coefs := array.new<float>(nFeat + 1, 0.0)
        for j = 0 to nFeat
            array.set(coefs, j, matrix.get(beta, j, 0))
        haveCoefs := true

// ---------------------------------------------------------------------
// Predict target `horizonBars` bars ahead using THIS bar's features
// ---------------------------------------------------------------------
predict() =>
    float result = na
    if haveCoefs
        result := useMacro ?
             array.get(coefs, 0) * f1 +
             array.get(coefs, 1) * f2 +
             array.get(coefs, 2) * f3 +
             array.get(coefs, 3) * f4 +
             array.get(coefs, 4) * f5 +
             array.get(coefs, 5) * f6 +
             array.get(coefs, 6)
           :
             array.get(coefs, 0) * g1 +
             array.get(coefs, 1) * g2 +
             array.get(coefs, 2) * g3 +
             array.get(coefs, 3)
    result

pred = predict()

// ---------------------------------------------------------------------
// Plots
//
// "Forecast" line: this bar's prediction of the close `horizonBars` bars
// from now, drawn shifted forward — the leading blue-line effect.
// "Backtest" line: what the model predicted `horizonBars` bars ago for
// THIS bar, drawn at zero offset directly against the realized candle —
// the honesty check ("did the shifted line actually arrive where price
// went").
// ---------------------------------------------------------------------
plot(pred, title = "Macro fair value (forecast)", offset = horizonBars, color = color.new(color.blue, 0), linewidth = 2)

backtestPred = pred[horizonBars]
plot(showBacktest ? backtestPred : na, title = "Macro fair value (backtest, aligned)", color = color.new(color.orange, 40), linewidth = 1)

// ---------------------------------------------------------------------
// Lightweight live honesty gauge
//
// This is NOT the Node dashboard's full oosStats (rank-IC + t-stat +
// circular-shift null p-value + split-half stability) — that suite is
// impractical to run every bar inside Pine's per-bar compute budget.
// This is a plain rolling Pearson correlation between the backtested
// prediction and the realized close over `corrWindow` bars, as a rough
// "is this line tracking reality at all right now" signal. Treat a
// reading here as a hint to go check the real stats on the dashboard,
// not as a substitute for them. For "Risk appetite" mode especially,
// a high reading can partly reflect XLY's structural overlap with
// NAS100 constituents rather than a genuine leading relationship —
// don't read this number alone as proof of an edge.
// ---------------------------------------------------------------------
liveCorr = ta.correlation(backtestPred, target, corrWindow)

var label corrLabel = na
if barstate.islast
    label.delete(corrLabel)
    corrLabel := label.new(bar_index + horizonBars, high, modeInput + " corr(" + str.tostring(corrWindow) + "): " + str.tostring(liveCorr, "#.##"), style = label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white)
